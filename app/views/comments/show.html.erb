<main>
    <%= turbo_stream_from "comment-show-#{@comment.id}" %>
    <div class="p-[5px]">
        <%= link_to "Back", "javascript:history.back()", class: "p-[2px] border-[2px] rounded-[5px] font-semibold" %>
    </div>
    <%= render @comment, {no_response: true, class: "show-element" }  %>
    <%= form_with model: Comment.new, url: comment_comments_path(@comment.id), data: { controller: :form, action: "turbo:submit-end->form#clear" },
    class: "flex flex-col items-start p-5 gap-[5px]" do |form| %>
        <%= form.textarea :content, size: "50x3", class: "p-[5px] border-[2px] rounded-[5px]", data: {
                form_target: "field",
                action: "input->form#disableIfEmptyFields"
            } %>
        <%= form.submit "Create", data: {
                form_target: "submit",
            }, class: "p-[2px] border-[2px] rounded-[5px] font-semibold" %>
    <% end %>
    <div id="comment-show-comments-<%= @comment.id %>">
        <%= render partial: "comment", collection: @comments %>
    </div>
    <% if @pagy.next.present? %>
        <%= turbo_frame_tag :next_page, src: comment_path(@comment.id, page: @pagy.next, format: :turbo_stream), loading: :lazy %>
    <% end %>
</main>