<main>
    <%= turbo_stream_from "posts-#{@user.id}" %>
    <div class="p-[5px]">
        <%= link_to "Back", "javascript:history.back()", class: "p-[2px] border-[2px] rounded-[5px] font-semibold" %>
    </div>
    <div class="flex justify-center pb-5">
        <%= render @user, class: "show-element" %>
    </div>
    <div id="posts-<%= @user.id %>">
        <%= render partial: "posts/post", collection: @posts %>
    </div>
    <% if @pagy.next.present? %>
        <%= turbo_frame_tag :next_page, src: user_path(@user.id, page: @pagy.next, format: :turbo_stream), loading: :lazy %>
    <% end %>
</main>