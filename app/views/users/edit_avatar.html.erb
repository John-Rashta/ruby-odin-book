 <main class="flex p-20 justify-center">
    <%= form_with url: change_avatar_path, method: :put, class: "flex flex-col items-center gap-5", data: { controller: "form image-preview", action: "turbo:submit-end->form#clear" } do |form| %>
        <img src="<%= current_user.avatar.attached? ? url_for(current_user.avatar) : current_user.avatar_url %>" data-image-preview-target="canvas" class="object-cover size-60 rounded-full border-1 border-solid">
        <%= form.file_field "user[avatar]", class:"file:mr-4 file:rounded-full file:border-0 file:bg-slate-200 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-olive-600", accept: "image/png,image/jpeg,image/jpg,image/webp", data: {
            form_target: "field",
            action: "image-preview#show input->form#disableIfEmptyFields",
            image_preview_target: "source"
        }  %>
        <%= form.submit "Upload", class:"border-solid border-1 rounded-lg px-3 py-1 bg-sky-200 text-lg font-bold text-mist-700 ", data: {
            form_target: "submit",
        } %>
    <% end %>
</main>