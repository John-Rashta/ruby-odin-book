<%= turbo_stream.update "notice" do %>
    <%= notice %>
<% end %>
<%= turbo_stream.update "alert" do %>
<% end %>
<% if @request.table_type == "follow" && @request.sender_id == current_user.id %>
    <%= turbo_stream.update "user-followship-#{@request.user_id}" do %>
        <%= button_to "Cancel Request", request_path(@request.id) , method: "delete", params: {request: {user_id: @request.user_id}} %>
    <% end %>
<% end %>